    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json;\nif (!r || !r.ok) {\n  return [{ json: { pesan: 'Laporan gagal dibuat: ' + ((r && r.error) || 'sumber berita tidak merespons') } }];\n}\nconst jam = new Date().toLocaleTimeString('id-ID', { timeZone: 'Asia/Jakarta', hour: '2-digit', minute: '2-digit' });\nconst judul = (r.berita || []).map((b, i) => '  ' + (i + 1) + '. ' + b.judul + ' (' + b.sumber + ')').join('\\n');\nconst pesan = [\n  'Laporan selesai pada ' + jam + ' WIB.',\n  '',\n  r.jumlah + ' berita terkini diambil dari sumber yang tersambung, lalu disusun',\n  'menjadi satu dokumen PDF berukuran ' + Math.max(1, Math.round(r.bytes / 1024)) + ' KB:',\n  '',\n  judul,\n  '',\n  'Dokumennya bisa dibuka atau diunduh lewat tombol di bawah.'\n].join('\\n');\nreturn [{ json: { pesan, pdf: r.pdf, thumb: r.thumb, judul: r.judul, jumlah: r.jumlah } }];"
      },
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Susun Ringkasan",
      "type": "n8n-nodes-base.code",
