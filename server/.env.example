# === Reddie API configuration ===
PORT=8080
DATABASE_URL=postgres://reddie:CHANGE_ME_DB_PASSWORD@reddie-db:5432/reddie

# Secret untuk JWT admin (ganti dengan string acak panjang)
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS

# Akun admin pertama (dibuat otomatis saat boot bila belum ada)
ADMIN_EMAIL=ilham@wit.id
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# === API keys provider AI (isi yang dipakai saja; kosong = provider nonaktif) ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Provider lain yang kompatibel OpenAI (mis. Groq/Together/Ollama):
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# Rate limit chat publik
CHAT_MAX_PER_SESSION=20
CHAT_MAX_PER_IP_HOUR=60
CHAT_MAX_TOKENS=1024

# Token API manajemen task (ingat.reddie.id). Rahasia — jangan masuk repo.
TASK_API_TOKEN=

# Google Calendar (opsional). Tanpa ini, meeting dicatat sebagai jadwal internal.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_ACCOUNT=

# n8n (opsional). Tanpa API key, peta koneksi tetap tampil tapi workflow
# tidak bisa didaftar maupun dijalankan.
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=

# Jembatan kendali agent. Kosong = fitur Agentic Control mati.
AGENT_BRIDGE_TOKEN=
